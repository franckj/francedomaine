---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
const L = SITE.legal;
---
<Base title="Mentions légales | FranceDomaine.fr" description="Mentions légales du site FranceDomaine.fr : éditeur, directeur de la publication, hébergeur.">
  <div class="container narrow prose">
    <h1>Mentions légales</h1>
    <h2>Éditeur</h2>
    <p>{L.company}, {L.form}<br />Siège social : {L.address}<br />{L.rcs} · SIRET {L.siret}<br />TVA intracommunautaire : {L.vat}</p>
    <p>Directeur de la publication : {L.director}</p>
    <p>Contact : <a class="js-mail" data-kind="general" href="/contact/"><span class="js-mail-text">voir la page Contact</span></a></p>
    <h2>Hébergement</h2>
    <p>Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, États-Unis (cloudflare.com).</p>
    <h2>Propriété intellectuelle</h2>
    <p>Les textes et éléments graphiques de ce site appartiennent à {L.company}. Les noms de domaine présentés font partie de son portefeuille et sont proposés à la vente.</p>
    <h2>Données personnelles</h2>
    <p>Voir la page <a href="/confidentialite/">Confidentialité</a>.</p>
  </div>
</Base>
