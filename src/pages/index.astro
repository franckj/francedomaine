---
// Sales page: hero → problem → why the right domain → for whom → selection → how to buy → FAQ → final CTA.
// Copy lives in src/data/home.ts.
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import SoldGrid from '../components/SoldGrid.astro';
import { listed, sold, categories } from '../lib/domains';
import { faqLd } from '../lib/faq';
import { SITE } from '../lib/site';
import { hero, problem, reasons, audiences, faq, finalCta } from '../data/home';

const all = await listed();
const available = all.filter((d) => d.status === 'disponible');
const featured = available.filter((d) => d.featured);
const show = (featured.length >= 3 ? featured : available).slice(0, 6);
const cats = await categories();
const done = await sold();
const years = new Date().getFullYear() - SITE.since;
---
<Base title={SITE.title} description={SITE.description} path="/" jsonLd={[faqLd(faq)]}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title.before}<span class="hl">{hero.title.hl}</span>{hero.title.after}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero-cta">
        <a class="btn" href="/domaines/">Voir les {available.length} domaines disponibles</a>
        <a class="btn btn-ghost" href="#pourquoi">Pourquoi le nom compte</a>
      </div>
      <ul class="stats">
        <li><strong>{available.length}</strong><span>domaines disponibles</span></li>
        {done.length > 0
          ? <li><strong>{done.length}</strong><span>domaines déjà vendus</span></li>
          : <li><strong>{cats.length}</strong><span>secteurs</span></li>}
        <li><strong>{years}+</strong><span>ans d'expertise</span></li>
        <li><strong>24–72 h</strong><span>pour le transfert</span></li>
      </ul>
    </div>
  </section>

  <div class="container">
    <section class="section problem">
      <div>
        <h2>{problem.title}</h2>
        <p class="muted big">{problem.intro}</p>
      </div>
      <ul>{problem.points.map((p) => <li>{p}</li>)}</ul>
    </section>

    <section class="section" id="pourquoi">
      <h2>{reasons.title}</h2>
      <p class="muted big narrowp">{reasons.intro}</p>
      <div class="reasons">
        {reasons.items.map((r, i) => (
          <div class="reason"><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{r.t}</h3><p class="muted">{r.d}</p></div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>{audiences.title}</h2>
      <div class="aud">
        {audiences.items.map((a) => <div><h3>{a.t}</h3><p class="muted">{a.d}</p></div>)}
      </div>
    </section>

    <section class="section">
      <div class="head">
        <h2>Notre sélection</h2>
        <a href="/domaines/">Tout le catalogue →</a>
      </div>
      <Catalog items={show} filters={false} id="une" />
      <div class="cats">
        {cats.map((c) => <a href={`/categories/${c.slug}/`}>{c.name} <span>{c.items.length}</span></a>)}
      </div>
    </section>

    <div class="section"><SoldGrid items={done} limit={8} /></div>
    <div class="section"><Steps /></div>
    <div class="section"><Faq items={faq} /></div>
    <div class="section"><Cta title={finalCta.title} text={finalCta.text} /></div>
  </div>
</Base>

<style>
  .hero { background: var(--soft); padding: 72px 0 48px; border-bottom: 1px solid var(--line); }
  .hero h1 { max-width: 900px; }
  .hl { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: .09em; text-underline-offset: .14em; }
  .lead { font-size: 19px; color: var(--muted); max-width: 680px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 28px 0 40px; }
  .stats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 36px; }
  .stats li { display: grid; }
  .stats strong { font-size: 26px; }
  .stats span { color: var(--muted); font-size: 14px; }
  .big { font-size: 18px; }
  .narrowp { max-width: 680px; }
  .problem { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; padding: 40px; background: var(--soft); border-radius: var(--radius); }
  .problem ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .problem li { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px 14px 44px; position: relative; }
  .problem li::before { content: '✕'; position: absolute; left: 16px; top: 14px; color: var(--red); font-weight: 700; }
  .reasons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 28px; }
  .reason { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .reason .n { color: var(--accent); font-weight: 700; font-size: 14px; letter-spacing: 1px; }
  .reason h3 { margin: 8px 0 8px; }
  .reason p { font-size: 15px; margin: 0; }
  .aud { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 20px; }
  .aud div { padding: 26px; background: var(--accent-soft); border-radius: var(--radius); }
  .aud p { margin: 0; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 20px; }
  .head h2 { margin: 0; }
  .head a { text-decoration: none; font-weight: 600; }
  .cats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .cats a { border: 1px solid var(--line); border-radius: 99px; padding: 8px 16px; color: var(--ink); text-decoration: none; background: #fff; font-size: 15px; }
  .cats a:hover { border-color: var(--accent); color: var(--accent); }
  .cats span { color: var(--muted); font-size: 13px; margin-left: 4px; }
  @media (max-width: 1000px) { .reasons { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .problem, .aud { grid-template-columns: 1fr; } .problem { padding: 24px; gap: 20px; } .hero { padding-top: 48px; } }
  @media (max-width: 520px) { .reasons { grid-template-columns: 1fr; } }
</style>
