---
const values = [
  {
    icon: '✓',
    title: 'Mémorabilité',
    description: 'Un domaine premium se retient dès la première lecture. Il devient un actif marketing qui travaille pour vous 24h/24.'
  },
  {
    icon: '★',
    title: 'Crédibilité',
    description: "Les entreprises établies possèdent des domaines premium. C'est un signal de confiance immédiat pour vos clients."
  },
  {
    icon: '↗',
    title: 'Valorisation',
    description: "Les noms de domaine premium s'apprécient avec le temps. C'est un actif digital qui prend de la valeur."
  }
];
---

<section class="value-props">
  <div class="container">
    <div class="value-header">
      <p class="section-label">Pourquoi choisir un domaine premium</p>
      <h2>Investissez dans votre identité digitale</h2>
    </div>
    <div class="value-grid">
      {values.map(value => (
        <div class="value-item">
          <div class="value-icon">{value.icon}</div>
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .value-props {
    padding: 100px 0;
    background: var(--color-bg-alt);
  }

  .value-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .value-header h2 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: var(--color-text);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .value-item {
    background: white;
    padding: 32px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .value-item:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .value-icon {
    width: 48px;
    height: 48px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 20px;
  }

  .value-item h3 {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .value-item p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .value-props {
      padding: 60px 0;
    }
  }
</style>
