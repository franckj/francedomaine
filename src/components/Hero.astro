---
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <p class="section-label animate-in delay-1">Domaines Premium</p>
      <h1 class="animate-in delay-2">
        Trouvez le nom de domaine <span class="highlight">parfait</span> pour votre marque
      </h1>
      <p class="hero-desc animate-in delay-3">
        Une sélection exclusive de noms de domaine premium en .fr et .com,
        soigneusement choisis pour les entreprises ambitieuses.
      </p>
      <div class="hero-cta animate-in delay-3">
        <button class="cta-button" id="discoverBtn">
          Voir le portfolio
        </button>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">25+</span>
            <span class="stat-label">ans d'expertise</span>
          </div>
          <div class="stat">
            <span class="stat-number">15</span>
            <span class="stat-label">domaines disponibles</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('discoverBtn')?.addEventListener('click', () => {
    document.getElementById('portfolio')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>

<style>
  .hero {
    padding: 80px 0 120px;
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .hero-content {
    max-width: 700px;
  }

  .hero h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 24px;
    color: var(--color-text);
  }

  .hero h1 .highlight {
    color: var(--color-primary);
  }

  .hero-desc {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-text-light);
    margin-bottom: 40px;
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: flex;
    gap: 32px;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-text);
  }

  .stat-label {
    font-size: 13px;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 60px 0 80px;
    }

    .hero-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .hero-stats {
      gap: 24px;
    }
  }
</style>
