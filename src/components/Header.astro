---
import FrenchFlag from './FrenchFlag.astro';
---

<header class="animate-in">
  <div class="logo">
    <div class="logo-icon">FD</div>
    <div class="logo-text">
      <span>France</span>
      <span>Domaine</span>
    </div>
    <FrenchFlag />
  </div>
  <nav>
    <a href="#portfolio">Portfolio</a>
    <a href="#expertise">Expertise</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<style>
  header {
    padding: 40px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .logo-icon {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(201, 162, 39, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 300;
    color: #c9a227;
  }

  .logo-text {
    font-family: "Outfit", sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .logo-text span:first-child {
    color: #c9a227;
    font-weight: 400;
  }

  .logo-text span:last-child {
    color: #888;
    font-weight: 300;
    display: block;
  }

  nav {
    display: flex;
    gap: 48px;
    font-family: "Outfit", sans-serif;
    font-size: 13px;
    letter-spacing: 1px;
  }

  nav a {
    color: #a0a0a0;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  nav a:hover {
    color: #c9a227;
  }

  :global(body.light-mode) .logo-text span:last-child {
    color: #666;
  }

  :global(body.light-mode) nav a {
    color: #666;
  }

  :global(body.light-mode) nav a:hover {
    color: #a68520;
  }

  @media (max-width: 768px) {
    header {
      padding: 24px 24px;
      flex-direction: column;
      gap: 24px;
    }

    nav {
      gap: 24px;
    }
  }
</style>
