---
---

<header class="animate-in">
  <div class="container header-inner">
    <a href="/" class="logo">
      <div class="logo-mark">FD</div>
      <div class="logo-text">
        <span class="logo-name">FranceDomaine</span>
        <span class="logo-tagline">Domaines Premium</span>
      </div>
    </a>
    <nav>
      <a href="#portfolio">Portfolio</a>
      <a href="#expertise">Expertise</a>
      <a href="#contact" class="nav-cta">Contact</a>
    </nav>
  </div>
</header>

<style>
  header {
    padding: 20px 0;
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .logo-mark {
    width: 42px;
    height: 42px;
    background: var(--color-primary);
    color: white;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
  }

  .logo-tagline {
    font-size: 12px;
    color: var(--color-text-light);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav a {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-light);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--color-primary);
  }

  .nav-cta {
    background: var(--color-primary);
    color: white !important;
    padding: 10px 20px;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .nav-cta:hover {
    background: #0052cc;
    color: white !important;
  }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 16px;
    }

    .logo-text {
      display: none;
    }

    nav {
      gap: 16px;
    }

    nav a:not(.nav-cta) {
      display: none;
    }
  }
</style>
