---
const path = Astro.url.pathname;
const nav = [
  { href: '/domaines/', label: 'Noms de domaine' },
  { href: '/#pourquoi', label: 'Le nom de domaine parfait' },
  { href: '/#achat', label: 'Comment acheter' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="FranceDomaine.fr, accueil">
      <span class="logo-word" aria-hidden="true">France<br />Domaine</span>
    </a>
    <nav aria-label="Navigation principale">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      <a href="/contact/" class="btn btn-small">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .logo { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .logo-word { font-family: var(--logo); font-weight: 700; text-transform: uppercase; color: var(--accent); font-size: 21px; line-height: .88; letter-spacing: .01em; }
  nav { display: flex; align-items: center; gap: 24px; }
  nav a:not(.btn) { color: var(--muted); text-decoration: none; font-size: 15px; font-weight: 500; }
  nav a:not(.btn):hover, nav a[aria-current] { color: var(--ink); }
  @media (max-width: 720px) { nav a:not(.btn) { display: none; } }
</style>
