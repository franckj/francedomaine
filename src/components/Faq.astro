---
// FAQ with FAQPage JSON-LD built by the page (see faqLd). Native <details>: no script needed.
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions fréquentes' } = Astro.props;
---
<section class="faq" id="faq">
  <h2>{title}</h2>
  <div class="list">
    {items.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .list { display: grid; gap: 10px; margin-top: 24px; max-width: 820px; }
  details { border: 1px solid var(--line); border-radius: var(--radius); background: #fff; padding: 0 20px; }
  summary { cursor: pointer; list-style: none; padding: 18px 0; font-weight: 600; font-size: 17px; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--accent); font-size: 22px; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { color: var(--muted); margin: 0 0 18px; }
</style>
