---
interface Props {
  large?: boolean;
}

const { large = false } = Astro.props;
---

<div class:list={["french-flag", { large }]}>
  <div class="blue"></div>
  <div class="white"></div>
  <div class="red"></div>
</div>

<style>
  .french-flag {
    display: flex;
    gap: 2px;
    opacity: 0.8;
  }

  .french-flag div {
    width: 3px;
    height: 16px;
    border-radius: 1px;
  }

  .french-flag .blue { background: #000091; }
  .french-flag .white { background: #FFFFFF; }
  .french-flag .red { background: #E1000F; }

  .french-flag.large div {
    width: 4px;
    height: 24px;
    border-radius: 2px;
  }

  :global(body.light-mode) .french-flag .white {
    background: #FFFFFF;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.1);
  }
</style>
