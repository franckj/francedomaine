---
interface Domain {
  name: string;
  category: string;
  highlight: boolean;
  description: string;
}

const domains: Domain[] = [
  { name: 'aurae.fr', category: 'Luxe & Lifestyle', highlight: true, description: "Évocation poétique de l'aura et de la lumière, idéal pour une marque de parfumerie, joaillerie ou bien-être haut de gamme." },
  { name: 'hotelroyal.fr', category: 'Hôtellerie', highlight: false, description: "Le nom ultime pour un établissement hôtelier d'exception ou une chaîne visant le segment luxe en France." },
  { name: 'flandres.com', category: 'Géographique', highlight: false, description: "Domaine géographique premium couvrant la région des Flandres, parfait pour le tourisme, l'immobilier ou les produits régionaux." },
  { name: 'synergetic.fr', category: 'Business & Tech', highlight: false, description: "Nom moderne et dynamique pour une entreprise de conseil, un cabinet de fusion-acquisition ou une agence d'innovation." },
  { name: 'infracloud.fr', category: 'Tech & Cloud', highlight: true, description: "Combinaison puissante infrastructure + cloud, taillé pour un hébergeur, un MSP ou une société d'infogérance." },
  { name: 'velobox.fr', category: 'Sport & Mobilité', highlight: false, description: "Nom accrocheur pour une startup de livraison à vélo, un service de vélos en libre-service ou une box mensuelle cyclisme." },
  { name: 'francemed.fr', category: 'Santé', highlight: true, description: "Association France + médecine, idéal pour une plateforme de télémédecine, un réseau de cliniques ou un portail santé national." },
  { name: 'omnify.fr', category: 'Tech & SaaS', highlight: false, description: "Nom court et moderne évoquant l'unification et la puissance, parfait pour une solution SaaS ou une plateforme omnicanale." },
  { name: 'superaliments.fr', category: 'Santé & Nutrition', highlight: true, description: "Exact match domain à fort trafic SEO pour une boutique e-commerce, un blog nutrition ou une marque de compléments." },
  { name: 'occultation.fr', category: 'Industrie', highlight: false, description: "Terme technique recherché par les professionnels du store, du volet roulant et de la protection solaire." },
  { name: 'lemillion.com', category: 'Finance & Luxe', highlight: false, description: "Nom évocateur et mémorable pour une fintech, un club d'investisseurs ou une marque lifestyle premium." },
  { name: 'mytherapy.fr', category: 'Santé & Bien-être', highlight: false, description: "Nom personnel et rassurant pour une application de suivi thérapeutique, un cabinet de psychologie ou une plateforme bien-être." },
  { name: 'intelligencephysique.com', category: 'Sport & Coaching', highlight: false, description: "Concept unique alliant corps et esprit, idéal pour un coach sportif, une méthode de préparation physique ou un centre d'entraînement." },
  { name: 'nextchat.fr', category: 'Tech & Communication', highlight: false, description: "Nom futuriste et accessible pour une application de messagerie, un outil de support client ou une startup IA conversationnelle." },
  { name: 'mysticker.fr', category: 'E-commerce & Créatif', highlight: false, description: "Nom friendly et personnalisable pour une boutique de stickers personnalisés, une imprimerie créative ou une marque lifestyle." }
];

const filters = [
  { label: 'Tous', value: 'all' },
  { label: 'Luxe & Lifestyle', value: 'Luxe & Lifestyle' },
  { label: 'Tech & Cloud', value: 'Tech & Cloud' },
  { label: 'Santé', value: 'Santé' },
  { label: 'Business & Tech', value: 'Business & Tech' },
  { label: 'E-commerce', value: 'E-commerce & Créatif' }
];
---

<section id="portfolio" class="portfolio">
  <div class="portfolio-header">
    <div>
      <p class="section-label">Portfolio</p>
      <h2>Domaines disponibles</h2>
    </div>
    <div class="filters">
      {filters.map((filter, index) => (
        <button
          class:list={["filter-btn", { active: index === 0 }]}
          data-filter={filter.value}
        >
          {filter.label}
        </button>
      ))}
    </div>
  </div>

  <div class="domains-grid" id="domainsGrid">
    {domains.map((domain, index) => (
      <div
        class:list={["domain-card", { highlight: domain.highlight }]}
        data-category={domain.category}
        style={`animation-delay: ${index * 0.05}s`}
      >
        {domain.highlight && <div class="premium-badge">Premium</div>}
        <p class="domain-category">{domain.category}</p>
        <h3 class="domain-name">{domain.name}</h3>
        <p class="domain-description">{domain.description}</p>
        <div class="domain-footer">
          <span>Disponible</span>
          <a
            href={`mailto:contact@francedomaine.fr?subject=${encodeURIComponent('Intérêt pour le domaine ' + domain.name)}&body=${encodeURIComponent('Bonjour,\n\nJe suis intéressé(e) par le nom de domaine ' + domain.name + '.\n\nPouvez-vous me communiquer plus d\'informations ?\n\nCordialement')}`}
            target="_blank"
            rel="noopener"
          >
            En savoir plus →
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const domainCards = document.querySelectorAll('.domain-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      domainCards.forEach(card => {
        const category = card.getAttribute('data-category') || '';
        const matches = filter === 'all' ||
                       category === filter ||
                       category.includes(filter?.replace('E-commerce & Créatif', 'E-commerce') || '');
        card.classList.toggle('hidden', !matches);
      });
    });
  });
</script>

<style>
  .portfolio {
    padding: 120px 60px;
  }

  .portfolio-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    flex-wrap: wrap;
    gap: 32px;
  }

  .portfolio h2 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    letter-spacing: -0.5px;
  }

  .filters {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid rgba(201, 162, 39, 0.2);
    color: #a0a0a0;
    padding: 8px 20px;
    font-family: "Outfit", sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .filter-btn:hover {
    border-color: rgba(201, 162, 39, 0.5);
    color: #f5f5f0;
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #c9a227 0%, #a68520 100%);
    border-color: #c9a227;
    color: #0a0a0a;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .domain-card {
    background: linear-gradient(145deg, rgba(30,30,30,0.9) 0%, rgba(20,20,20,0.95) 100%);
    border: 1px solid rgba(201, 162, 39, 0.15);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    padding: 40px 32px;
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .domain-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 0%, rgba(201, 162, 39, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .domain-card:hover {
    border-color: rgba(201, 162, 39, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 60px rgba(201, 162, 39, 0.1);
  }

  .domain-card:hover::before {
    opacity: 1;
  }

  .domain-card.highlight {
    border-color: rgba(201, 162, 39, 0.3);
  }

  .domain-card.hidden {
    display: none;
  }

  .premium-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    font-family: "Outfit", sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    color: #c9a227;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid rgba(201, 162, 39, 0.3);
    background: rgba(201, 162, 39, 0.05);
  }

  .domain-category {
    font-family: "Outfit", sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 16px;
    position: relative;
  }

  .domain-name {
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    color: #f5f5f0;
    position: relative;
  }

  .domain-card.highlight .domain-name {
    color: #c9a227;
  }

  .domain-description {
    font-family: "Outfit", sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: #777;
    margin-bottom: 24px;
    min-height: 60px;
    position: relative;
  }

  .domain-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .domain-footer span {
    font-family: "Outfit", sans-serif;
    font-size: 12px;
    color: #888;
    letter-spacing: 1px;
  }

  .domain-footer a {
    font-family: "Outfit", sans-serif;
    font-size: 12px;
    color: #c9a227;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
    position: relative;
    z-index: 10;
  }

  .domain-footer a:hover {
    opacity: 0.8;
  }

  /* Light mode */
  :global(body.light-mode) .filter-btn {
    border-color: rgba(201, 162, 39, 0.3);
    color: #555;
  }

  :global(body.light-mode) .filter-btn:hover {
    color: #1a1a1a;
  }

  :global(body.light-mode) .domain-card {
    background: linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(248,247,244,0.98) 100%);
    border-color: rgba(201, 162, 39, 0.2);
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  :global(body.light-mode) .domain-card:hover {
    box-shadow: 0 20px 40px rgba(0,0,0,0.1), 0 0 60px rgba(201, 162, 39, 0.1);
  }

  :global(body.light-mode) .domain-card::before {
    background: linear-gradient(135deg, transparent 0%, rgba(201, 162, 39, 0.08) 100%);
  }

  :global(body.light-mode) .domain-category {
    color: #888;
  }

  :global(body.light-mode) .domain-name {
    color: #1a1a1a;
  }

  :global(body.light-mode) .domain-card.highlight .domain-name {
    color: #a68520;
  }

  :global(body.light-mode) .domain-description {
    color: #666;
  }

  :global(body.light-mode) .domain-footer span {
    color: #888;
  }

  :global(body.light-mode) .domain-footer a {
    color: #a68520;
  }

  :global(body.light-mode) .premium-badge {
    color: #a68520;
    border-color: rgba(201, 162, 39, 0.4);
    background: rgba(201, 162, 39, 0.1);
  }

  @media (max-width: 768px) {
    .portfolio {
      padding: 80px 24px;
    }
  }
</style>
