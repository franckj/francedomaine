---
// Import domains from external JSON file
import domainsData from '../data/domains.json';

interface Domain {
  name: string;
  category: string;
  premium: boolean;
  description: string;
}

const domains: Domain[] = domainsData.domains;

// Auto-generate unique categories from the data
const uniqueCategories = [...new Set(domains.map(d => d.category))].sort();

// Create filter buttons: "Tous" + all unique categories
const filters = [
  { label: 'Tous', value: 'all' },
  ...uniqueCategories.map(cat => ({ label: cat, value: cat }))
];
---

<section id="portfolio" class="portfolio">
  <div class="container">
    <div class="portfolio-header">
      <div>
        <p class="section-label">Portfolio</p>
        <h2>Domaines disponibles</h2>
        <p class="portfolio-count">{domains.length} domaines disponibles</p>
      </div>
      <div class="filters">
        {filters.map((filter, index) => (
          <button
            class:list={["filter-btn", { active: index === 0 }]}
            data-filter={filter.value}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>

    <div class="domains-grid" id="domainsGrid">
      {domains.map((domain, index) => (
        <div
          class:list={["domain-card", { highlight: domain.premium }]}
          data-category={domain.category}
          style={`animation-delay: ${index * 0.03}s`}
        >
          {domain.premium && <div class="premium-badge">Premium</div>}
          <p class="domain-category">{domain.category}</p>
          <h3 class="domain-name">{domain.name}</h3>
          <p class="domain-description">{domain.description}</p>
          <div class="domain-footer">
            <span class="status">Disponible</span>
            <a
              href={`mailto:contact@francedomaine.fr?subject=${encodeURIComponent('Intérêt pour le domaine ' + domain.name)}&body=${encodeURIComponent('Bonjour,\n\nJe suis intéressé(e) par le nom de domaine ' + domain.name + '.\n\nPouvez-vous me communiquer plus d\'informations ?\n\nCordialement')}`}
              target="_blank"
              rel="noopener"
              class="domain-link"
            >
              En savoir plus
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const domainCards = document.querySelectorAll('.domain-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      domainCards.forEach(card => {
        const category = card.getAttribute('data-category') || '';
        const matches = filter === 'all' || category === filter;
        card.classList.toggle('hidden', !matches);
      });
    });
  });
</script>

<style>
  .portfolio {
    padding: 100px 0;
  }

  .portfolio-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    flex-wrap: wrap;
    gap: 24px;
  }

  .portfolio h2 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: var(--color-text);
  }

  .portfolio-count {
    font-size: 14px;
    color: var(--color-text-light);
    margin-top: 8px;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-light);
    padding: 8px 16px;
    font-family: var(--font-main);
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .domain-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 24px;
    position: relative;
    transition: all 0.2s ease;
    opacity: 0;
    animation: fadeIn 0.4s ease-out forwards;
  }

  .domain-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 20px rgba(0, 102, 255, 0.1);
    transform: translateY(-2px);
  }

  .domain-card.highlight {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .domain-card.hidden {
    display: none;
  }

  .premium-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--color-primary);
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 4px;
    background: white;
  }

  .domain-category {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--color-text-light);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .domain-name {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .domain-card.highlight .domain-name {
    color: var(--color-primary);
  }

  .domain-description {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-light);
    margin-bottom: 20px;
  }

  .domain-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .status {
    font-size: 13px;
    font-weight: 500;
    color: #10b981;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status::before {
    content: '';
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
  }

  .domain-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .domain-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .portfolio {
      padding: 60px 0;
    }

    .domains-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
