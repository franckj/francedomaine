---
import SoldCard from './SoldCard.astro';
import type { Domain } from '../lib/domains';
interface Props { items: Domain[]; limit?: number; title?: string }
const { items, limit, title = 'Déjà vendus' } = Astro.props;
const list = limit ? items.slice(0, limit) : items;
---
{items.length > 0 && (
  <section class="sold-sec" id="vendus">
    <h2>{title}</h2>
    <p class="muted">{items.length} noms de notre portefeuille ont déjà trouvé leur marque. Comme dans l'immobilier : une fois vendu, il ne revient pas.</p>
    <div class="grid">{list.map((d) => <SoldCard d={d} />)}</div>
    {limit && items.length > limit && <p><a href="/domaines/#vendus">Voir les {items.length} domaines vendus →</a></p>}
  </section>
)}
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin: 20px 0 16px; }
  .sold-sec a { font-weight: 600; text-decoration: none; }
</style>
