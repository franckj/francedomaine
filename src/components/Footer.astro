---
import { SITE } from '../lib/site';
import { categories } from '../lib/domains';
const cats = await categories();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="f-logo" aria-label="FranceDomaine.fr, accueil">France<br />Domaine</a>
      <p class="muted">Noms de domaine premium en .fr et .com. 25 ans d’expertise en noms de domaine.</p>
      <p><a class="js-mail" data-kind="general" href="/contact/"><span class="js-mail-text">Nous écrire</span></a></p>
    </div>
    <div>
      <p class="f-title">Catégories</p>
      <ul>{cats.map((c) => <li><a href={`/categories/${c.slug}/`}>{c.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="f-title">Le site</p>
      <ul>
        <li><a href="/domaines/">Tous les domaines</a></li>
        <li><a href="/#achat">Comment acheter</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/confidentialite/">Confidentialité</a></li>
      </ul>
    </div>
  </div>
  <div class="container f-bottom muted">© {year} FranceDomaine.fr · {SITE.legal.company}</div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--soft); padding: 56px 0 28px; margin-top: 96px; font-size: 15px; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1.3fr 1fr; gap: 40px; }
  .f-logo { font-family: var(--logo); font-weight: 700; text-transform: uppercase; color: var(--accent); font-size: 26px; line-height: .88; letter-spacing: .01em; text-decoration: none; display: inline-block; margin-bottom: 10px; }
  .f-title { font-weight: 600; margin-bottom: 10px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  ul a, .site-footer p a { color: var(--muted); text-decoration: none; }
  ul a:hover, .site-footer p a:hover { color: var(--accent); }
  .f-bottom { border-top: 1px solid var(--line); margin-top: 40px; padding-top: 20px; font-size: 13px; }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
