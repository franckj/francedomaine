---
// A sold domain, real-estate style: a red rubber stamp "VENDU" (Rouge Marianne) across the card. No link, no price.
import { shown, tld, type Domain } from '../lib/domains';
interface Props { d: Domain }
const { d } = Astro.props;
const n = shown(d);
const t = tld(n);
---
<div class="sold" data-search={`${d.id} vendu`}>
  <span class="name">{n.slice(0, -t.length)}<wbr /><span class="tld">{t}</span></span>
  {d.sold_on && <span class="when">Vendu en {d.sold_on.slice(0, 4)}</span>}
  <span class="stamp" aria-label="Vendu">Vendu</span>
</div>
<style>
  .sold { position: relative; display: grid; gap: 4px; align-content: start; min-height: 120px; padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .name { font-size: 18px; font-weight: 700; color: #6b7280; overflow-wrap: anywhere; }
  .tld { color: #9aa3b2; white-space: nowrap; }
  .when { font-size: 13px; color: var(--muted); }
  .stamp {
    position: absolute; right: 14px; bottom: 14px; transform: rotate(-12deg);
    color: var(--red); border: 3px solid var(--red); border-radius: 6px; outline: 1.5px solid var(--red); outline-offset: 2px;
    padding: 2px 12px; font-size: 20px; font-weight: 900; letter-spacing: 3px; text-transform: uppercase; line-height: 1.3;
    opacity: .88; background: rgba(255,255,255,.6); pointer-events: none;
    -webkit-mask-image: radial-gradient(circle at 30% 40%, #000 60%, rgba(0,0,0,.75) 61%, #000 75%);
            mask-image: radial-gradient(circle at 30% 40%, #000 60%, rgba(0,0,0,.75) 61%, #000 75%);
  }
</style>
